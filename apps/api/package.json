{
  "name": "@interval/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Interval application API (Express + TypeScript, relational SQLite store, Postgres-ready schema).",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "seed": "tsx --env-file-if-exists=.env src/seed.ts",
    "test": "tsx --test src/__tests__/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "loadtest": "tsx scripts/loadtest.ts",
    "backup": "tsx scripts/backup.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "google-auth-library": "^11.1.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
