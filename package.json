{
  "name": "interval",
  "version": "0.1.0",
  "private": true,
  "description": "Interval — quiz portal for the sAIDE website (IIT Ropar). From-scratch graded & practice assessments.",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev:api": "pnpm --filter @interval/api dev",
    "dev:web": "pnpm --filter @interval/web dev",
    "build:api": "pnpm --filter @interval/api build",
    "build:web": "pnpm --filter @interval/web build",
    "build": "pnpm run build:api && pnpm run build:web",
    "seed": "pnpm --filter @interval/api seed",
    "start:api": "pnpm --filter @interval/api start",
    "start:web": "pnpm --filter @interval/web preview",
    "test": "pnpm --filter @interval/api test",
    "typecheck": "pnpm -r run typecheck"
  }
}
